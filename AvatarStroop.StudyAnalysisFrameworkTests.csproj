<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>AvatarStroop.Tests.StudyAnalyzerTestMain</StartupObject>
    <TargetFramework>net48</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <DefineConstants>$(DefineConstants);STROOP_TEST_BUILD;VIVE_RAW_SYNTHETIC_TEST</DefineConstants>
    <AppConfig>Apps/StudyAnalyzer.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="AvatarStroop.PhotonRealtime.csproj" />
    <Reference Include="PhotonClient"><HintPath>Assets/Photon/PhotonLibs/PhotonClient.dll</HintPath></Reference>
    <Compile Include="Assets/Stroop/Core/**/*.cs" />
    <Compile Include="Assets/Stroop/Runtime/**/*.cs" />
    <Compile Include="Tests/**/*.cs" Exclude="Tests/WozLanPairingUiTests.cs" />
  </ItemGroup>
</Project>
