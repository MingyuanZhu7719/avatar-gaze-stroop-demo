<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>AvatarStroop.Tests.Program</StartupObject>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <DefineConstants>$(DefineConstants);STROOP_TEST_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Assets/Stroop/Core/**/*.cs" />
    <Compile Include="Assets/Stroop/Runtime/**/*.cs" />
    <!-- WinForms/CLR4 coverage has its own AvatarStroop.WozLanPairingUiTests project. -->
    <Compile Include="Tests/**/*.cs" Exclude="Tests/WozLanPairingUiTests.cs" />
  </ItemGroup>
</Project>
